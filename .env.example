# Copy to .env for local use, or enter these on Render (Environment tab).
ENVIRONMENT=development
SECRET_KEY=change-me-to-a-long-random-string
SITE_URL=https://www.your-domain.com
# Leave empty locally to use a SQLite file; Render fills this in automatically.
DATABASE_URL=

# First team account, created on first start. Change the password after signing in.
ADMIN_EMAIL=rayan@your-domain.com
ADMIN_PASSWORD=a-long-password-of-at-least-10-characters
ADMIN_NAME=Rayan Altarouti

# Email (any SMTP service). Needed to email studies and to notify the team.
SMTP_HOST=smtp.your-mail-provider.com
SMTP_PORT=587
SMTP_TLS=starttls
SMTP_USER=studies@your-domain.com
SMTP_PASSWORD=
MAIL_FROM=HeatHarvest <studies@your-domain.com>
TEAM_NOTIFY_EMAIL=team@your-domain.com

# Name on the studies
SIGNATORY_NAME=Prof. Awad Alquaity
SIGNATORY_EMAIL=awad.alquaity@kfupm.edu.sa
SIGNATORY_PHONE=+966 53 194 6761
